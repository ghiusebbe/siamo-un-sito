# Nessuna variabile è esposta al browser: niente prefisso NEXT_PUBLIC_.
# Dominio editoriale fisso in lib/site-url.ts, anche nei deploy di preview.
# Mantieni coerente questo valore nelle integrazioni che lo usano.
SITE_URL=https://siamounmagazine.com
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
GAM_ARTICLE_INLINE_PATH=
GAM_ARTICLE_FOOTER_PATH=
# ID account AdSense, in una delle due forme (ca-pub-… o pub-…): serve il tag
# nell'head e compone ads.txt. ADS_TXT ha la precedenza sul file generato.
ADSENSE_PUBLISHER_ID=
ADS_TXT=
# Blocchi AdSense per i due spazi, usati solo se le unità Ad Manager qui sopra
# non sono configurate. Sono gli ID numerici delle unità display di AdSense.
ADSENSE_ARTICLE_INLINE_SLOT=
ADSENSE_ARTICLE_FOOTER_SLOT=
# Newsletter su Brevo Free. Chiave API v3 e ID numerico della lista destinatari.
# Solo lato server. Attivazione RSS e attributi consenso: docs/newsletter-brevo.md.
BREVO_API_KEY=
BREVO_LIST_ID=
